on fs
    symlink /system_root/system /system
    symlink /dev/block/platform/bootdevice/by-name /dev/block/by-name
    
    write /sys/class/power_supply/usb/otg_switch 1
    
    export ANDROID_ROOT /system_root
    
on early-init

    start hwservicemanager
    start servicemanager

on init

    export PATH /sbin:/system/bin
    export LD_LIBRARY_PATH /sbin

    mkdir /vendor 0755 root root
    mkdir /vendor/bin 0755 root root
    mkdir /vendor/bin/hw 0755 root root
    mkdir /vendor/lib64 0755 root root
    mkdir /vendor/lib64/hw 0755 root root
    mkdir /vendor/app 0755 root root
    mkdir /vendor/etc 0755 root root
    mkdir /vendor/etc/init 0755 root root
    mkdir /vendor/etc/permissions 0755 root root
    mkdir /vendor/lib 0755 root root
    mkdir /vendor/lib/hw 0755 root root

    write /sys/class/graphics/fb0/blank 0

    setprop crypto.ready 1

on boot
	setprop hwservicemanager.ready true

service logd /sbin/logd
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service hwservicemanager /sbin/hwservicemanager
    user root
    group root
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

service servicemanager /sbin/servicemanager
    user root
    group root readproc
    disabled
    seclabel u:r:recovery:s0

service mobicore /sbin/mcDriverDaemon --P1 /sbin/mcRegistry
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /sbin/android.hardware.gatekeeper@1.0-service
    setenv LD_LIBRARY_PATH /sbin
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-3-0 /sbin/android.hardware.keymaster@3.0-service
    setenv LD_LIBRARY_PATH /sbin
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service hal_cryptoeng_oppo /vendor/bin/hw/vendor.oppo.hardware.cryptoeng@1.0-service
	setenv LD_LIBRARY_PATH /sbin
	user root
	group root drmrpc
	disabled
	seclabel u:r:recovery:s0

on property:crypto.ready=0
    stop keymaster-3-0
    stop gatekeeper-1-0
    stop servicemanager

on property:hwservicemanager.ready=true
    start mobicore
    start hal_cryptoeng_oppo
    start keymaster-3-0
    start gatekeeper-1-0
    
on post-fs
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

