# Core partitions
/dev/block/platform/bootdevice/by-name/recovery      /recovery      emmc    defaults                    defaults
/dev/block/platform/bootdevice/by-name/boot          /boot          emmc    defaults                    defaults

# System partitions
/dev/block/platform/bootdevice/by-name/system        /system         ext4    ro                          wait
/dev/block/platform/bootdevice/by-name/vendor        /vendor         ext4    ro                          wait
/dev/block/platform/bootdevice/by-name/odm           /odm            ext4    ro                          wait

# User partitions
/dev/block/platform/bootdevice/by-name/cache         /cache          ext4    noatime,nosuid,nodev        wait,check,formattable
/dev/block/platform/bootdevice/by-name/userdata      /data           ext4    noatime,nosuid,nodev        wait,check,formattable
/dev/block/platform/bootdevice/by-name/metadata      /metadata       ext4    noatime,nosuid,nodev        wait,check

# MTK/Oppo partitions
/dev/block/platform/bootdevice/by-name/nvram         /nvram          emmc    defaults                    defaults
/dev/block/platform/bootdevice/by-name/nvdata        /nvdata         ext4    noatime,nosuid,nodev        wait
/dev/block/platform/bootdevice/by-name/nvcfg         /nvcfg          ext4    noatime,nosuid,nodev        wait
/dev/block/platform/bootdevice/by-name/persist       /persist        ext4    noatime,nosuid,nodev        wait
/dev/block/platform/bootdevice/by-name/protect1      /protect1       ext4    noatime,nosuid,nodev        wait
/dev/block/platform/bootdevice/by-name/protect2      /protect2       ext4    noatime,nosuid,nodev        wait
/dev/block/platform/bootdevice/by-name/opporeserve2  /opporeserve    ext4    noatime,nosuid,nodev        wait

# Security / firmware
/dev/block/platform/bootdevice/by-name/frp           /persistent     emmc    defaults                    defaults
/dev/block/platform/bootdevice/by-name/vbmeta        /vbmeta         emmc    defaults                    defaults
/dev/block/platform/bootdevice/by-name/dtbo          /dtbo           emmc    defaults                    defaults
/dev/block/platform/bootdevice/by-name/boot_para     /boot_para      emmc    defaults                    defaults
/dev/block/platform/bootdevice/by-name/para          /para           emmc    defaults                    defaults

# External storage
/dev/block/mmcblk1p1                                 /external_sd    vfat    defaults                    voldmanaged=sdcard1:auto
/dev/block/sda1                                      /usb_otg        vfat    defaults                    voldmanaged=usb:auto
